"""Text commands in the message field: .calc, .time, .up, .rev and your own templates."""

import ast
import datetime
import operator

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Divider, Header, Input, Switch

__id__ = "commands"
__name__ = "Commands"
__description__ = "Type .calc 2*21, .time, .up text, .rev text or .t name (a template from settings) and send."
__author__ = "MyTelegram"
__version__ = "1.0"

_OPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow,
    ast.USub: operator.neg, ast.UAdd: operator.pos,
}


def _calc(expr):
    def ev(node):
        if isinstance(node, ast.Expression):
            return ev(node.body)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in _OPS:
            if isinstance(node.op, ast.Pow) and abs(ev(node.right)) > 100:
                raise ValueError("too big")
            return _OPS[type(node.op)](ev(node.left), ev(node.right))
        if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:
            return _OPS[type(node.op)](ev(node.operand))
        raise ValueError("bad expression")
    result = ev(ast.parse(expr.replace(",", ".").replace("^", "**"), mode="eval"))
    if isinstance(result, float) and result.is_integer():
        result = int(result)
    return result


DEFAULT_TEMPLATES = "hi=Hello! How are you?\naddr=Example street 1"


class CommandsPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def create_settings(self):
        return [
            Header("Commands"),
            Switch("keep_expr", "Keep the expression in .calc", True, subtext="2*21 = 42 instead of 42"),
            Input("prefix", "Command prefix", "."),
            Divider(),
            Header("Templates (.t name)"),
            Input("templates", "Templates", DEFAULT_TEMPLATES,
                  subtext="One per line: name=text", multiline=True),
            Divider(),
        ]

    def _templates(self):
        result = {}
        for line in str(self.get_setting("templates", DEFAULT_TEMPLATES)).splitlines():
            if "=" in line:
                name, text = line.split("=", 1)
                result[name.strip()] = text.strip()
        return result

    def on_send_message_hook(self, account, params):
        text = params.message
        prefix = self.get_setting("prefix", ".") or "."
        if not text or not text.startswith(prefix):
            return HookResult()
        cmd, _, arg = text[len(prefix):].partition(" ")
        try:
            if cmd == "calc" and arg:
                value = _calc(arg)
                new = f"{arg} = {value}" if self.get_setting("keep_expr", True) else str(value)
            elif cmd == "time":
                new = datetime.datetime.now().strftime("%H:%M:%S, %d.%m.%Y")
            elif cmd == "up" and arg:
                new = arg.upper()
            elif cmd == "rev" and arg:
                new = arg[::-1]
            elif cmd == "t" and arg in self._templates():
                new = self._templates()[arg]
            else:
                return HookResult()
        except Exception as e:
            self.log(f"{cmd}: {e}")
            return HookResult()
        params.message = new
        return HookResult(strategy=HookStrategy.MODIFY, params=params)
